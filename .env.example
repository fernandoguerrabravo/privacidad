# Clave de API de Anthropic para generar las conclusiones con Claude.
# Si no se define, el sistema usa un análisis automático local (fallback).
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Credenciales de acceso al panel (login).
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Secreto para firmar la sesión (cámbialo por una cadena larga y aleatoria).
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
